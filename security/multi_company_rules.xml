<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reglas de registro multiempresa. Los modelos supplier.* se
             declaran primero en ESTE módulo (stock_transit_allocation los
             re-declara con _name), por eso las reglas viven aquí.
             company_id vacío = registro histórico/compartido: visible. -->

        <record id="rule_supplier_proforma_header_company" model="ir.rule">
            <field name="name">Proforma de proveedor: multiempresa</field>
            <field name="model_id" ref="model_supplier_proforma_header"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

