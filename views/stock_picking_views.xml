<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_packing_import" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.packing.import</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <field name="partner_id" position="after">
                <field name="has_packing_list" invisible="1"/>
                <field name="packing_list_imported" invisible="1"/>
                <field name="worksheet_imported" invisible="1"/>
                <field name="spreadsheet_id" invisible="1"/>
                <field name="ws_spreadsheet_id" invisible="1"/>
                <field name="packing_list_file" invisible="1"/>
                <field name="packing_list_filename" invisible="1"/>
                <field name="worksheet_file" invisible="1"/>
                <field name="worksheet_filename" invisible="1"/>
                <field name="supplier_access_ids" invisible="1"/>
            </field>
            
            <!-- NOTA: el botón 'Reasignar PL a nueva recepción' vive en la
                 vista de stock_transit_allocation (dueño del campo
                 supplier_shipment_id; aquí la validación de la vista corre
                 antes de que ese campo exista en el registry incremental). -->
            <!-- FLUJO NUMERADO 0-7: los números sustituyen a los íconos para
                 que el orden del proceso sea inequívoco (sin emojis en ningún
                 paso, incluido el 7 que vive en stock_transit_allocation).
                 0 Comenzar · 1 Abrir PL · 2 Procesar PL · 3 Imprimir WS ·
                 4 Editar WS · 5 Procesar WS · 6 Validar · 7 Etiquetas. -->

            <!-- En recepciones, los nativos Comprobar disponibilidad y
                 Validar se sustituyen por sus versiones numeradas 0 y 6. -->
            <xpath expr="//header/button[@name='action_assign']" position="attributes">
                <attribute name="invisible">not show_check_availability or picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_validate'][hasclass('oe_highlight')]" position="attributes">
                <attribute name="invisible">state in ('draft', 'confirmed', 'done', 'cancel') or picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_validate'][hasclass('o_btn_validate')]" position="attributes">
                <attribute name="invisible">state in ('waiting', 'assigned', 'done', 'cancel') or picking_type_code == 'incoming'</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_assign']" position="after">
                <button name="action_assign"
                        string="0. Comenzar"
                        type="object"
                        class="oe_highlight"
                        invisible="not show_check_availability or picking_type_code != 'incoming'"/>

                <button name="action_open_packing_list_spreadsheet"
                        string="1. Abrir PL"
                        type="object"
                        class="btn-primary"
                        invisible="state in ('done', 'cancel', 'draft') or (picking_type_code != 'incoming' and not packing_list_imported) or packing_list_imported or worksheet_imported"/>

                <button name="action_import_packing_list"
                        string="2. Procesar PL"
                        type="object"
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel', 'draft') or (picking_type_code != 'incoming' and not packing_list_imported) or packing_list_imported or not spreadsheet_id or worksheet_imported"/>

                <button name="action_open_packing_list_spreadsheet"
                        string="1. Corregir PL"
                        type="object"
                        class="btn-warning"
                        invisible="state in ('done', 'cancel', 'draft') or not packing_list_imported or worksheet_imported"/>

                <button name="action_import_packing_list"
                        string="2. Reprocesar PL"
                        type="object"
                        class="btn-warning"
                        invisible="state in ('done', 'cancel', 'draft') or not packing_list_imported or worksheet_imported"/>

                <button name="action_print_worksheet_pdf"
                        string="3. Imprimir Worksheet"
                        type="object"
                        class="btn-info"
                        invisible="state in ('done', 'cancel', 'draft') or not packing_list_imported"/>

                <button name="action_open_worksheet_spreadsheet"
                        string="4. Abrir WS"
                        type="object"
                        class="btn-info"
                        invisible="state in ('done', 'cancel', 'draft') or not packing_list_imported"/>

                <button name="action_import_worksheet"
                        string="5. Procesar WS"
                        type="object"
                        class="btn-success"
                        invisible="state in ('done', 'cancel', 'draft') or not packing_list_imported or not ws_spreadsheet_id or worksheet_imported"/>

                <!-- WS ya procesado pero recepción SIN validar: aún se puede
                     corregir (reprocesa medidas/cantidades reales). Después de
                     validar, solo ajuste manual de inventario. -->
                <button name="action_import_worksheet"
                        string="5. Corregir WS"
                        type="object"
                        class="btn-warning"
                        invisible="state in ('done', 'cancel', 'draft') or not worksheet_imported or not ws_spreadsheet_id"/>

                <button name="button_validate"
                        string="6. Validar"
                        type="object"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="state in ('draft', 'done', 'cancel') or picking_type_code != 'incoming'"/>
            </xpath>

            <!-- Nueva Pestaña: Datos de Embarque -->
            <xpath expr="//notebook" position="inside">
                <page string="Datos de Embarque" invisible="(picking_type_code != 'incoming' and not packing_list_imported)">
                    <group>
                        <group string="Documentación">
                            <field name="supplier_invoice_number"/>
                            <field name="supplier_shipment_date"/>
                            <field name="supplier_proforma_number"/>
                            <field name="supplier_bl_number"/>
                            <field name="supplier_payment_terms"/>
                        </group>
                        <group string="Logística">
                            <field name="supplier_origin"/>
                            <field name="supplier_destination"/>
                            <field name="supplier_country_origin"/>
                            <field name="supplier_vessel"/>
                            <field name="supplier_incoterm_payment" string="Incoterm"/>
                            <field name="supplier_status"/>
                        </group>
                    </group>
                    <group string="Detalles de Carga">
                        <group>
                            <field name="supplier_container_no"/>
                            <field name="supplier_seal_no"/>
                            <field name="supplier_container_type"/>
                        </group>
                        <group>
                            <field name="supplier_total_packages"/>
                            <field name="supplier_gross_weight"/>
                            <field name="supplier_volume"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="supplier_merchandise_desc" nolabel="1" placeholder="Descripción general de la mercancía..."/>
                    </group>
                </page>

                <page string="Acceso Proveedor" invisible="not supplier_access_ids">
                    <field name="supplier_access_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="create_date" string="Generado"/>
                            <field name="purchase_id" string="Desde OC"/>
                            <field name="is_expired" widget="boolean_toggle"/>
                            <field name="portal_url" widget="CopyClipboardChar"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>