<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_supplier_portal" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.supplier.portal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="x_in_cargo_invoice" invisible="1"/>
                <button name="action_open_supplier_link_wizard"
                        string="Portal Proveedor (PL)"
                        type="object"
                        class="btn-dark"
                        icon="fa-share-alt"
                        invisible="state not in ('purchase', 'done') or x_in_cargo_invoice"/>

                <button name="action_download_vucem"
                        string="Descargar VUCEM"
                        type="object"
                        class="btn-success"
                        icon="fa-download"
                        invisible="not has_vucem_documents"/>
            </xpath>

            <!-- Solicitado Original y Embarcado (PL) ya NO van en la lista
                 principal de líneas: viven en la pestaña Logística de la OC
                 (stock_transit_allocation) para liberar columnas. -->

            <xpath expr="//notebook" position="inside">
                <page string="Links Portal" invisible="not supplier_access_ids or x_in_cargo_invoice">
                    <field name="supplier_access_ids">
                        <list create="0" delete="0" edit="0">
                            <field name="create_date" string="Generado"/>
                            <field name="expiration_date"/>
                            <field name="is_expired" widget="boolean_toggle"/>
                            <field name="portal_url" widget="CopyClipboardChar" readonly="1"/>
                            <button name="action_send_whatsapp" type="object"
                                    string="WhatsApp" icon="fa-whatsapp"
                                    title="Enviar la liga por WhatsApp con instrucciones"/>
                            <button name="action_open_portal" type="object"
                                    string="Abrir" icon="fa-external-link"
                                    class="btn-link" title="Abrir el portal en una pestaña nueva"/>
                        </list>
                    </field>

                    <div class="alert alert-info" role="alert">
                        El portal del proveedor ya no se liga a una sola recepción.
                        <br/>
                        El link abre la captura general de la OC y cada embarque crea su propia recepción.
                    </div>
                </page>

                <page string="VUCEM" invisible="not has_vucem_documents">
                    <field name="has_vucem_documents" invisible="1"/>
                    <field name="vucem_document_count" invisible="1"/>

                    <div class="alert alert-info" role="alert">
                        <strong><i class="fa fa-file-pdf-o"/> Documentos VUCEM</strong>
                        <p>Se encontraron <field name="vucem_document_count" readonly="1"/> documentos (portal + pagos internos).</p>
                        <p>Al descargar, los PDFs serán convertidos a escala de grises y procesados automáticamente.</p>
                        <p>Los archivos no-PDF se incluyen tal cual. Todo se organiza en subcarpetas Documentos/ y Pagos/.</p>
                    </div>

                    <button name="action_download_vucem"
                            string="Descargar Carpeta VUCEM"
                            type="object"
                            class="btn-primary btn-lg"
                            icon="fa-download"/>

                    <field name="vucem_document_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="document_type"/>
                            <field name="name"/>
                            <field name="file_size"/>
                            <field name="dpi_value"/>
                            <field name="mime_type"/>
                            <field name="create_date" string="Subido"/>
                        </list>
                    </field>
                </page>

                <page string="Pagos VUCEM">
                    <group>
                        <group>
                            <field name="payment_document_count" readonly="1"/>
                            <field name="has_payment_documents" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong><i class="fa fa-money"/> Documentos de Pago</strong>
                        <p>Elige el tipo, sube el archivo y listo: la orden de compra se
                           liga sola y el nombre se toma del archivo subido. Estos
                           comprobantes aplican a toda la OC (no a un embarque o
                           proforma) y entran automáticamente en la descarga VUCEM.</p>
                    </div>

                    <!-- Captura en 2 pasos: Tipo → Archivo. El nombre se llena
                         solo al subir (filename); la OC la pone la relación y
                         embarque/proforma no aplican a pagos (el modelo los
                         limpia). Form embebido limpio para que el expandir la
                         línea no muestre el form autogenerado con IDs crudos. -->
                    <field name="payment_document_ids" context="{'default_purchase_id': id, 'default_document_type': 'advance_payment'}">
                        <list editable="bottom">
                            <field name="purchase_id" column_invisible="1"/>
                            <field name="mime_type" column_invisible="1"/>
                            <field name="document_type" string="Tipo de Pago"/>
                            <field name="file_data" string="Archivo (clic para subir)" filename="name"/>
                            <field name="name" string="Nombre" placeholder="Se llena solo al subir el archivo"/>
                            <field name="notes" optional="show"/>
                            <field name="file_size" string="Tamaño" readonly="1" optional="hide"/>
                            <field name="create_date" string="Subido" readonly="1"/>
                        </list>
                        <form string="Documento de Pago">
                            <group>
                                <group>
                                    <field name="document_type" string="Tipo de Pago"/>
                                    <field name="file_data" string="Archivo" filename="name"/>
                                    <field name="name" string="Nombre"/>
                                </group>
                                <group>
                                    <field name="notes"/>
                                    <field name="create_date" string="Subido" readonly="1"/>
                                </group>
                            </group>
                            <field name="purchase_id" invisible="1"/>
                        </form>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>